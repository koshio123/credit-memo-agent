# EDINET API v2 のキー（https://disclosure2.edinet-fsa.go.jp/ で取得）
EDINET_API_KEY=

# LLMバックエンド: claude_code | local | anthropic_api
LLM_BACKEND=local

# ローカルLLM（Ollama）。fast=分類・抽出 / standard=分析・起草 / strong=計画・検証
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_FAST=qwen3:8b
LOCAL_MODEL_STANDARD=qwen3:14b
LOCAL_MODEL_STRONG=qwen3:14b
# コンテキスト長（Ollamaの既定は短く、超えた入力は黙って切り捨てられる）と思考モード
LOCAL_NUM_CTX=16384
LOCAL_THINK=false

# 応答キャッシュ（同じ入力ならLLMを呼ばない）
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm

# PostgreSQL（docker compose up -d --wait で起動。ホスト側は5433）
POSTGRES_USER=credit_memo
POSTGRES_PASSWORD=credit_memo
POSTGRES_DB=credit_memo
POSTGRES_PORT=5433
DATABASE_URL=postgresql://credit_memo:credit_memo@127.0.0.1:5433/credit_memo
