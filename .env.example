# EDINET API v2 のキー（https://disclosure2.edinet-fsa.go.jp/ で取得）
EDINET_API_KEY=

# LLMバックエンド: claude_code | local | anthropic_api
LLM_BACKEND=local

# ローカルLLM（Ollama）
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL（docker compose up -d --wait で起動。ホスト側は5433）
POSTGRES_USER=credit_memo
POSTGRES_PASSWORD=credit_memo
POSTGRES_DB=credit_memo
POSTGRES_PORT=5433
DATABASE_URL=postgresql://credit_memo:credit_memo@127.0.0.1:5433/credit_memo
